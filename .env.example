# Tesla Fleet API app credentials (developer.tesla.com)
TESLA_CLIENT_ID=your_fleet_api_client_id
# Only needed if your app is a confidential client
TESLA_CLIENT_SECRET=your_fleet_api_client_secret
# Refresh token from your OAuth authorization flow — used once to bootstrap
# .fleet_token.json, after which tokens rotate automatically.
TESLA_REFRESH_TOKEN=your_fleet_api_refresh_token
# Regional endpoint (default: North America)
# TESLA_FLEET_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com

PUSHOVER_TOKEN=your_pushover_app_token
PUSHOVER_USER=your_pushover_user_key

# Notify when battery hits this % during charging (default: 80)
TARGET_PERCENT=80

# Notify after this many minutes into a charging session (default: 240 = 4 hours)
TIMER_MINUTES=240
